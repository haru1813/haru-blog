---
import { SITE_TITLE } from '../consts';
const path = Astro.url.pathname;
const isHome = path === '/';
const isBlog = path.startsWith('/blog');
const isAbout = path.startsWith('/about');
---

<aside class="sidebar">
	<a class="brand" href="/">Haru<b>.</b>DevLog</a>

	<div class="prof">
		<div class="ava">H</div>
		<div class="nm">박하루</div>
		<div class="rl">보안 · 인프라 · 풀스택 개발자</div>
	</div>

	<div class="grp-wrap">
		<div class="grp">카테고리</div>
		<div class="cats">
			<a class={`cat-all ${path === '/blog' ? 'on' : ''}`} href="/blog">전체 글</a>
			<div class="cat-group">
				<div class="cat-head">개발</div>
				<a href="/blog/category/backend" class={path.startsWith('/blog/category/backend') ? 'on' : ''}>Java Backend</a>
				<a href="/blog/category/web" class={path.startsWith('/blog/category/web') ? 'on' : ''}>web</a>
			</div>
			<div class="cat-group">
				<div class="cat-head">인프라 · 보안</div>
				<a href="/blog/category/infra" class={path.startsWith('/blog/category/infra') ? 'on' : ''}>infra</a>
				<a href="/blog/category/security" class={path.startsWith('/blog/category/security') ? 'on' : ''}>security</a>
			</div>
		</div>
	</div>

	<a class="diary-link" href="/diary">일기 <span>🔒</span></a>

	<div class="side-foot">
		<a href="https://github.com/haru1813" target="_blank" rel="noopener">
			<span class="sr-only">GitHub</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
				><path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				></path></svg
			>
		</a>
		<span class="cp">© 2026 박하루</span>
	</div>
</aside>

<style>
	.sidebar {
		width: 252px;
		flex: none;
		align-self: stretch;
		background: var(--side);
		border-right: 1px solid var(--border);
		padding: 34px 26px;
		display: flex;
		flex-direction: column;
		gap: 26px;
	}
	.brand {
		font-size: 1.25rem;
		font-weight: 750;
		letter-spacing: -0.01em;
		color: rgb(var(--black));
		text-decoration: none;
	}
	.brand b { color: var(--accent); }

	.prof { display: flex; flex-direction: column; gap: 9px; }
	.ava {
		width: 52px; height: 52px; border-radius: 14px;
		background: var(--accent); color: #1a1206;
		font-weight: 800; font-size: 1.25rem;
		display: grid; place-items: center;
	}
	.prof .nm { font-weight: 700; font-size: 0.95rem; color: rgb(var(--black)); }
	.prof .rl { font-size: 0.8rem; color: rgb(var(--gray-dark)); }

	.nav { display: flex; flex-direction: column; gap: 2px; }
	.nav a {
		font-size: 0.85rem; color: rgb(var(--gray-dark));
		text-decoration: none; padding: 7px 10px; border-radius: 8px;
		font-family: var(--mono);
	}
	.nav a.on { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
	.nav a:hover { background: #22262f; }

	.grp { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.13em; color: rgb(var(--gray)); font-weight: 700; margin-bottom: 9px; }
	.cats { display: flex; flex-direction: column; gap: 16px; }
	.cat-group { display: flex; flex-direction: column; }
	.cat-head { font-size: 0.78rem; color: rgb(var(--black)); font-weight: 600; margin-bottom: 5px; }
	.cats a { font-size: 0.8rem; color: rgb(var(--gray)); text-decoration: none; padding: 3px 0 3px 12px; font-family: var(--mono); }
	.cats a:hover { color: var(--accent); }
	.cats a.on { color: var(--accent); font-weight: 600; }
	.cat-all { padding-left: 0; margin-bottom: 8px; color: rgb(var(--gray-dark)); }

	.diary-link {
		font-size: 0.82rem; color: rgb(var(--gray-dark));
		text-decoration: none; padding: 8px 11px; border-radius: 9px;
		font-family: var(--mono); background: var(--accent-soft);
		display: flex; align-items: center; gap: 6px; align-self: flex-start;
	}
	.diary-link:hover { color: var(--accent); }

	.chips { display: flex; flex-wrap: wrap; gap: 6px; }
	.chip { font-size: 0.7rem; color: var(--accent); background: var(--accent-soft); padding: 3px 9px; border-radius: 999px; font-weight: 600; }

	.side-foot {
		margin-top: auto; padding-top: 20px;
		border-top: 1px solid var(--border);
		display: flex; align-items: center; gap: 12px;
	}
	.side-foot a { color: rgb(var(--gray)); display: flex; }
	.side-foot a:hover { color: var(--accent); }
	.side-foot .cp { font-size: 0.72rem; color: rgb(var(--gray)); }

	@media (max-width: 760px) {
		.sidebar {
			width: 100%;
			border-right: 0;
			border-bottom: 1px solid var(--border);
			flex-direction: row;
			flex-wrap: wrap;
			align-items: center;
			gap: 16px;
			padding: 18px 22px;
		}
		.prof, .grp-wrap { display: none; }
		.nav { flex-direction: row; margin-left: auto; }
		.side-foot { margin: 0; padding: 0; border: 0; }
	}
</style>
