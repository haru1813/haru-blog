---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tops = posts.filter((p) => !p.data.parent);
const kids = (pid: string) =>
	posts
		.filter((p) => p.data.parent === pid)
		.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`Blog · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>전체 글</h1>
			<p class="lead">// {posts.length}개의 기록</p>

			<div class="card-list">
				{
					tops.map((post) => (
						<>
							<a class="postcard" href={`/blog/${post.id}/`}>
								<div class="d">
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h2>{post.data.title}</h2>
								{post.data.description && <p>{post.data.description}</p>}
							</a>
							{kids(post.id).length > 0 && (
								<div class="sub-posts">
									{kids(post.id).map((c) => (
										<a class="sub-post" href={`/blog/${c.id}/`}>
											<div class="sd">
												<span class="sub-arrow">↳</span>
												<FormattedDate date={c.data.pubDate} />
												<span>· 이어지는 글</span>
											</div>
											<div class="st">{c.data.title}</div>
										</a>
									))}
								</div>
							)}
						</>
					))
				}
			</div>
		</main>
	</body>
</html>

<style>
	main { max-width: none; }
	.lead {
		font-family: var(--mono);
		font-size: 0.85rem;
		color: rgb(var(--gray));
		margin: 2px 0 28px;
	}
</style>
